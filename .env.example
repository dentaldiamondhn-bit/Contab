# Database
DATABASE_URL="postgresql://contab_user:ContabSecure2024@localhost:5432/contab_dev"

# Supabase
#
# `SUPABASE_SERVICE_ROLE_KEY` SALTA el RLS por completo: da lectura y escritura
# sobre TODAS las empresas sin filtros. Por eso los scripts de `scripts/` la leen
# de aqui con `scripts/_supabase-env.js` y en ningun sitio esta escrita a mano
# (hubo 33 ficheros commiteados con ella dentro, el 2 Oct 2026).
#
# Esta clave NUNCA se commitea: vive solo en .env.local / entorno de despliegue.
# Si se filtra, rota; rotar no la borra del historial de git.
NEXT_PUBLIC_SUPABASE_URL=https://tu-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Envio de correo (Resend) - factura por email desde el POS
# Sin RESEND_API_KEY la opcion "Enviar por correo" responde 503 con un aviso.
RESEND_API_KEY=re_your_api_key
# Remitente verificado en Resend. En pruebas: Facturacion <onboarding@resend.dev>
EMAIL_FROM="Facturación <facturacion@tu-dominio.com>"
