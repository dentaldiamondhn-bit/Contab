import { NextRequest, NextResponse } from 'next/server';
import { createClient, SupabaseClient } from '@supabase/supabase-js';

// Usar credenciales directas (evita problemas con Proxy de supabase-db.ts)
const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || 'https://kudsqsbxbmviesiaesct.supabase.co';
const supabaseKey = process.env.SUPABASE_SERVICE_ROLE_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt1ZHNxc2J4Ym12aWVzaWFlc2N0Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NDQ4NTI5MSwiZXhwIjoyMDkwMDYxMjkxfQ.BvHT1ClcshuGXZTVkTj3TZNcCWboOyUagutdmDXYd8c';

const supabase: SupabaseClient = createClient(supabaseUrl, supabaseKey, {
  auth: {
    autoRefreshToken: false,
    persistSession: false
  }
});

interface PlanDB {
  id: string;
  name: string;
  code: string;
  price: number;
  max_users: number;
  max_storage: number;
  max_transactions: number;
  features: string;
  modules: string;
  is_active: boolean;
}

function mapPlanFromDB(p: PlanDB) {
  let features: string[] = [];
  let modules: any[] = [];
  try { features = JSON.parse(p.features); } catch { features = []; }
  try { modules = JSON.parse(p.modules); } catch { modules = []; }
  if (!Array.isArray(features)) features = [];
  if (!Array.isArray(modules)) modules = [];

  // Normalizar modules: string[] → { id }[], object[] → tal cual
  const normalizedModules = modules.map(m => {
    if (typeof m === 'string') return { id: m };
    if (m && typeof m === 'object' && m.id) return m;
    return null;
  }).filter(Boolean);

  return {
    id: p.id,
    code: p.code,
    name: p.name,
    description: p.name,
    unitPrice: p.price,
    subtotal: p.price,
    taxRate: 15,
    taxAmount: Math.round(p.price * 0.15),
    total: Math.round(p.price * 1.15),
    maxUsers: p.max_users,
    maxStorage: p.max_storage,
    maxTransactions: p.max_transactions,
    features,
    modules: normalizedModules,
    isActive: p.is_active,
  };
}

export async function GET(req: NextRequest) {
  try {
    // La tabla real es `Plan` (PascalCase)
    const { data: plans, error } = await supabase
      .from('Plan')
      .select('*')
      .eq('is_active', true)
      .order('price', { ascending: true });

    if (error) {
      console.error('Error fetching public plans:', error);
      // Intentar fallback: verificar si el error es de schema y intentar de nuevo
      if (error.message?.includes('permission denied for schema public')) {
        // Retry with service role bypass by trying direct query
        try {
          const { data: plans2, error2 } = await supabase
            .from('Plan')
            .select('*')
            .eq('is_active', true)
            .order('price', { ascending: true });
          if (!error2 && plans2) {
            const formattedPlans = (plans2 || []).map(mapPlanFromDB);
            return NextResponse.json({
              success: true,
              plans: formattedPlans,
              total: formattedPlans.length
            });
          }
        } catch (e) {
          // Continuar con error original
        }
      }
      return NextResponse.json({ error: 'Error interno' }, { status: 500 });
    }

    const formattedPlans = (plans || []).map(mapPlanPlanFromDB);

    return NextResponse.json({
      success: true,
      plans: formattedPlans,
      total: formattedPlans.length
    });

  } catch (error: any) {
    console.error('Error en GET /api/admin/plans-public:', error);
    return NextResponse.json(
      { error: 'Error interno del servidor' },
      { status: 500 }
    );
  }
}