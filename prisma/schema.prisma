generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Account {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  code        String
  type        String
  description String?
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  Tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([code, tenantId], map: "unique_code_tenant")
  @@index([tenantId], map: "idx_account_tenant")
  @@map("Account")
}

model Transaction {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  date          DateTime @default(now())
  description   String
  reference     String?
  voucherType   String   @map("voucher_type")
  voucherNumber Int      @map("voucher_number")
  currency      String   @default("HNL")
  exchangeRate  Decimal  @default(24.70) @map("exchange_rate")
  totalAmount   BigInt   @map("total_amount")
  clienteRTN    String?  @map("cliente_rtn")
  proveedorRTN  String?  @map("proveedor_rtn")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  Tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([voucherType, voucherNumber, tenantId], map: "unique_voucher_tenant")
  @@index([tenantId], map: "idx_transaction_tenant")
  @@map("Transaction")
}

model JournalEntry {
  id             String   @id @default(cuid())
  transactionId  String   @map("transaction_id")
  accountId      String   @map("account_id")
  tenantId       String   @map("tenant_id")
  amount         BigInt
  originalAmount BigInt   @map("original_amount")
  currency       String   @default("HNL")
  exchangeRate   Decimal  @default(24.70) @map("exchange_rate")
  description    String?
  cleared        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  Tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_entry_tenant")
  @@index([transactionId], map: "idx_entry_transaction")
  @@index([accountId], map: "idx_entry_account")
  @@map("JournalEntry")
}

model Tenant {
  id                String   @id @default(cuid())
  businessName      String   @map("businessname")
  businessRTN       String   @unique @map("businessrtn")
  businessEmail     String   @unique @map("businessemail")
  businessAddress   String   @map("businessaddress")
  tenantCode        String   @unique @map("tenantcode")
  country           String   @default("HN")
  phoneNumber       String   @map("phonenumber")
  logoUrl           String?  @map("logourl")
  timezone          String   @default("America/Tegucigalpa")
  currency          String   @default("HNL")
  subscriptionPlans String   @default("BASIC") @map("subscriptionplans")
  maxUsers          Int      @default(5) @map("maxusers")
  maxStorage        Int      @default(100) @map("maxstorage")
  maxTransactions   Int      @default(10000) @map("maxtransactions")
  monthlyCost       Int      @default(1000) @map("monthlycost")
  modules           String? // Comma-separated list of available modules
  isActive          Boolean  @default(true) @map("isactive")
  createdAt         DateTime @default(now()) @map("createdat")
  updatedAt         DateTime @updatedAt @map("updatedat")

  users         User[]
  accounts      Account[]
  transactions  Transaction[]
  entries       JournalEntry[]
  files         File[]
  fileTemplates FileTemplate[]
  invoices      Invoice[]
  cai           CAI[]
  SystemConfig  SystemConfig[]

  @@map("Tenant")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  Tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  tenantId    String?

  @@map("system_config")
}

model CAI {
  id            String   @id @default(cuid())
  tenantId      String?  @map("tenant_id")
  cai           String   @unique
  rangeStart    BigInt   @map("start_number")
  rangeEnd      BigInt   @map("end_number")
  currentNumber BigInt   @default(1) @map("current_number")
  issueDate     DateTime @map("issue_date")
  expiryDate    DateTime @map("expiration_date")
  isActive      Boolean  @default(true) @map("status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  invoices Invoice[]

  @@map("cai")
}

model File {
  id           String           @id @default(cuid())
  tenantId     String           @map("tenant_id")
  originalName String           @map("original_name")
  fileName     String           @map("file_name")
  filePath     String           @map("file_path")
  fileSize     Int              @map("file_size")
  mimeType     String           @map("mime_type")
  fileType     String           @map("file_type")
  category     String
  description  String?
  tags         String?
  uploadedBy   String           @map("uploaded_by")
  status       String           @default("active")
  metadata     String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities   FileActivity[]
  processing   FileProcessing[]
  template     FileTemplate?

  @@index([tenantId], map: "idx_file_tenant")
  @@index([uploadedBy], map: "idx_file_uploaded_by")
  @@index([fileType], map: "idx_file_type")
  @@index([category], map: "idx_file_category")
  @@index([status], map: "idx_file_status")
  @@index([createdAt], map: "idx_file_created_at")
  @@map("File")
}

model FileProcessing {
  id             String    @id @default(cuid())
  fileId         String    @map("file_id")
  processingType String    @map("processing_type")
  status         String
  progress       Int       @default(0)
  totalRows      Int?      @map("total_rows")
  processedRows  Int?      @map("processed_rows")
  errorCount     Int       @default(0) @map("error_count")
  errors         String?
  warnings       String?
  results        String?
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  file           File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId], map: "idx_processing_file_id")
  @@index([status], map: "idx_processing_status")
  @@index([startedAt], map: "idx_processing_started_at")
  @@map("FileProcessing")
}

model FileTemplate {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  templateType String   @map("template_type")
  fileId       String   @unique @map("file_id")
  schema       String
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_template_tenant")
  @@index([templateType], map: "idx_template_type")
  @@index([isActive], map: "idx_template_is_active")
  @@map("FileTemplate")
}

model FileActivity {
  id        String   @id @default(cuid())
  fileId    String   @map("file_id")
  userId    String   @map("user_id")
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId], map: "idx_activity_file_id")
  @@index([userId], map: "idx_activity_user_id")
  @@index([action], map: "idx_activity_action")
  @@index([createdAt], map: "idx_activity_created_at")
  @@map("FileActivity")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  authId    String?  @unique @map("auth_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  role      String   @default("user")
  isActive  Boolean  @default(true) @map("is_active")
  password  String?
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  sentMessages ChatMessage[] @relation("ChatMessageSender")
  receivedMessages ChatMessage[] @relation("ChatMessageReceiver")

  @@map("users")
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  price           Int
  maxUsers        Int      @map("max_users")
  maxStorage      Int      @map("max_storage")
  maxTransactions Int      @map("max_transactions")
  features        String // JSON array as string
  modules         String // JSON array of module ids
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  invoiceItems InvoiceItem[]

  @@map("Plan")
}

model Invoice {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenantid")
  invoiceNumber      String   @unique @map("invoiceNumber")
  invoiceDate        String   @map("invoiceDate")
  dueDate            String?   @map("dueDate")
  invoiceType        String   @default("CUSTOMER") @map("invoiceType") // CUSTOMER, SUBSCRIPTION, EXPENSE
  customerId         String   @map("customerid")
  customerRTN        String   @map("customerRTN")
  customerName       String   @map("customerName")
  customerEmail      String?  @map("customerEmail")
  customerAddress    String   @map("customerAddress")
  issuerRTN          String   @map("issuerRTN")
  issuerName         String   @map("issuerName")
  issuerAddress      String   @map("issuerAddress")
  issuerPhone        String?  @map("issuerPhone")
  issuerEmail        String?  @map("issuerEmail")
  cai                String
  rangeStart         Int      @map("rangeStart")
  rangeEnd           Int      @map("rangeEnd")
  expiryDate         String?   @map("expiryDate")
  establishmentCode  String   @default("0001") @map("establishmentCode")
  pointOfSaleCode    String   @default("0001") @map("pointOfSaleCode")
  items              String // JSON array de items
  subtotal           Float
  tax                Float    @default(0)
  totalTax           Float    @map("totalTax")
  total              Float
  notes              String?
  currency           String   @default("HNL")
  taxRate            Float    @default(15) @map("taxRate")
  status             String   @default("ACTIVE") // ACTIVE, PAID, CANCELLED, PENDING, OVERDUE
  invoiceImageUrl    String?  @map("invoiceImageUrl")
  createdAt          DateTime @default(now()) @map("createdat")
  updatedAt          DateTime @updatedAt @map("updatedat")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  CAI         CAI?          @relation(fields: [cAIId], references: [id])
  cAIId       String?        @map("caiid")
  InvoiceItem InvoiceItem[]

  @@index([tenantId], map: "idx_invoice_tenantid")
  @@index([status], map: "idx_invoice_status")
  @@index([invoiceDate], map: "idx_invoice_date")
  @@index([createdAt], map: "idx_invoice_createdat")
  @@index([invoiceType], map: "idx_invoice_invoiceType")
  @@index([invoiceNumber], map: "idx_invoice_invoiceNumber")
  @@map("Invoice")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoiceid")
  planId      String?  @map("planid")
  planName    String?  @map("planName")
  description String?
  quantity    Int      @default(1)
  unitPrice   Float    @map("unitprice")
  subtotal    Float    @map("totalamount") // Maps to existing column from view
  taxRate     Float    @default(15) @map("taxrate")
  taxAmount   Float    @default(0) @map("taxamount")
  total       Float
  createdAt   DateTime @default(now()) @map("createdat")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  plan    Plan?   @relation(fields: [planId], references: [id])

  @@index([invoiceId], map: "idx_invoiceitem_invoiceid")
  @@map("InvoiceItem")
}

model CompanyLogo {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  logoUrl     String   @map("logo_url")
  logoName    String?  @map("logo_name")
  logoSize    Int?     @map("logo_size")
  logoType    String?  @map("logo_type")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId], map: "unique_tenant_logo")
  @@index([tenantId], map: "idx_company_logos_tenant_id")
  @@index([createdAt], map: "idx_company_logos_created_at")
  @@map("company_logos")
}

model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String   @map("sender_id")
  receiverId  String?  @map("receiver_id") // Null for broadcast messages to all tenants
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  sender      User     @relation("ChatMessageSender", fields: [senderId], references: [id])
  receiver    User?    @relation("ChatMessageReceiver", fields: [receiverId], references: [id])

  @@index([senderId], map: "idx_chatmessage_sender")
  @@index([receiverId], map: "idx_chatmessage_receiver")
  @@index([createdAt], map: "idx_chatmessage_created")
  @@map("chat_message")
}
