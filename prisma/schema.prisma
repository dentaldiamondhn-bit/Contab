// Esquema para Contabilidad Multi-tenant Honduras
model Tenant {
  id           String        @id @default(dbgenerated("gen_random_uuid()"))
  businessName String        @map("businessName")
  businessRTN  String        @unique @map("businessRTN")
  accounts     Account[]
  transactions Transaction[]
  companies    Company[]

  @@map("Tenant")
}

model Company {
  id           String        @id @default(dbgenerated("gen_random_uuid()"))
  tenantId     String        @map("tenantId")
  name         String
  businessType String        @map("businessType")
  totalUnits   Int           @default(1) @map("totalUnits")
  unitPrice    Decimal       @default(0.00) @map("unitPrice")
  currency     String        @default("HNL")
  createdAt    DateTime      @default(now()) @map("createdAt")
  updatedAt    DateTime      @updatedAt @map("updatedAt")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customKpis   CustomKpi[]
  fixedCosts   FixedCost[]
  variableCosts VariableCost[]
  cashFlowData CashFlowData[]
  kpiMetrics   KpiMetric[]

  @@unique([tenantId])
  @@map("companies")
}

model CustomKpi {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId    String   @map("company_id")
  name         String
  description  String?
  unit         String
  currentValue Decimal  @default(0.00) @map("current_value")
  targetValue  Decimal  @default(0.00) @map("target_value")
  category     String   @default("custom")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("custom_kpis")
}

model FixedCost {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId    String   @map("company_id")
  rent         Decimal  @default(0.00)
  salaries     Decimal  @default(0.00)
  insurance    Decimal  @default(0.00)
  internet     Decimal  @default(0.00)
  permits      Decimal  @default(0.00)
  utilities    Decimal  @default(0.00)
  maintenance  Decimal  @default(0.00)
  periodMonth  Int      @map("period_month")
  periodYear   Int      @map("period_year")
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodMonth, periodYear])
  @@map("fixed_costs")
}

model VariableCost {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId   String   @map("company_id")
  electricity Decimal  @default(0.00)
  water       Decimal  @default(0.00)
  cleaning    Decimal  @default(0.00)
  materials   Decimal  @default(0.00)
  preventive  Decimal  @default(0.00)
  periodMonth Int      @map("period_month")
  periodYear  Int      @map("period_year")
  createdAt   DateTime @default(now()) @map("createdAt")
  updatedAt   DateTime @updatedAt @map("updatedAt")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodMonth, periodYear])
  @@map("variable_costs")
}

model CashFlowData {
  id                String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId         String   @map("company_id")
  month             String
  income            Decimal  @default(0.00)
  expenses          Decimal  @default(0.00)
  netCashFlow       Decimal  @default(0.00) @map("net_cash_flow")
  cumulativeCashFlow Decimal @default(0.00) @map("cumulative_cash_flow")
  periodMonth       Int      @map("period_month")
  periodYear        Int      @map("period_year")
  createdAt         DateTime @default(now()) @map("createdAt")
  updatedAt         DateTime @updatedAt @map("updatedAt")
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodMonth, periodYear])
  @@map("cash_flow_data")
}

model KpiMetric {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId    String   @map("company_id")
  kpiName      String   @map("kpi_name")
  value        Decimal
  unit         String
  periodMonth  Int      @map("period_month")
  periodYear   Int      @map("period_year")
  calculatedAt DateTime @default(now()) @map("calculated_at")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("kpi_metrics")
}

model Account {
  id        String         @id @default(dbgenerated("gen_random_uuid()"))
  tenantId  String         @map("tenantId")
  code      String
  name      String
  type      String         // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  entries   JournalEntry[]

  @@unique([code, tenantId])
  @@map("Account")
}

model Transaction {
  id               String         @id @default(dbgenerated("gen_random_uuid()"))
  tenantId         String         @map("tenantId")
  date             DateTime       @default(now())
  description      String
  voucherType      String         @map("voucherType") // INGRESO, EGRESO, DIARIO
  voucherNumber    Int            @map("voucherNumber")
  totalAmount      BigInt         @map("totalAmount")
  functionalAmount BigInt         @map("functionalAmount")
  originalTotal    BigInt         @map("originalTotal")
  currency         String         @default("HNL")
  exchangeRate     Decimal        @default(24.70) @map("exchangeRate")
  createdAt        DateTime       @default(now()) @map("createdAt")
  updatedAt        DateTime       @updatedAt @map("updatedAt")
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  entries          JournalEntry[]

  @@unique([voucherType, voucherNumber, tenantId])
  @@map("Transaction")
}

model JournalEntry {
  id             String      @id @default(dbgenerated("gen_random_uuid()"))
  transactionId  String      @map("transactionId")
  accountId      String      @map("accountId")
  tenantId       String      @map("tenantId")
  amount         BigInt      // Centavos: Positivo (Debe), Negativo (Haber)
  originalAmount BigInt      @map("originalAmount")
  currency       String      @default("HNL")
  exchangeRate   Decimal     @default(24.70) @map("exchangeRate")
  transaction    Transaction @relation(fields: [transactionId], references: [id])
  account        Account     @relation(fields: [accountId], references: [id])

  @@map("JournalEntry")
}

model CAIAuthorization {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  companyId      String   @map("company_id")
  codigo         String   // Código CAI completo (ej: 3B2D-5F1A-9876-1234)
  tipoDocumento  String   @map("tipo_documento") // Factura, Nota de Crédito, Nota de Débito
  rangoInicial   String   @map("rango_inicial")
  rangoFinal     String   @map("rango_final")
  fechaLimite    DateTime @map("fecha_limite")
  estado         String   @default("activo") // activo, proximo, vencido, agotado
  currentNumber  Int      @default(0) @map("current_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("cai_authorizations")
}