// Use BigInt for monetary values to avoid floating-point errors
// Use SQLite for development

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  name          String
  code          String
  type          String         // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  description   String?
  parentId      String?        @map("parent_id")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([code, tenantId], map: "unique_code_tenant")
  @@index([tenantId], map: "idx_account_tenant")
  @@map("Account")
}

model Transaction {
  id                    String         @id @default(cuid())
  tenantId              String         @map("tenant_id")
  date                  DateTime       @default(now())
  description           String
  reference             String?
  voucherType           String         @map("voucher_type") // "INGRESO", "EGRESO", "DIARIO", "AJUSTE"
  voucherNumber         Int            @map("voucher_number")
  currency              String         @default("HNL")
  exchangeRate          Decimal        @default(24.70) @map("exchange_rate")
  totalAmount           BigInt         @map("total_amount")
  clienteRTN            String?        @map("cliente_rtn")
  proveedorRTN          String?        @map("proveedor_rtn")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  @@unique([voucherType, voucherNumber, tenantId], map: "unique_voucher_tenant")
  @@index([tenantId], map: "idx_transaction_tenant")
  @@map("Transaction")
}

model JournalEntry {
  id                  String        @id @default(cuid())
  transactionId       String        @map("transaction_id")
  accountId           String        @map("account_id")
  tenantId            String        @map("tenant_id") // Multi-tenant support for RLS
  amount              BigInt        // Stored in cents (L. 1.00 = 100)
  originalAmount      BigInt        @map("original_amount")
  currency            String        @default("HNL")
  exchangeRate        Decimal       @default(24.70) @map("exchange_rate")
  description         String?       // Specific line description
  cleared             Boolean       @default(false)
  createdAt           DateTime      @default(now()) @map("created_at")

  @@index([tenantId], map: "idx_entry_tenant")
  @@index([transactionId], map: "idx_entry_transaction")
  @@index([accountId], map: "idx_entry_account")
  @@map("JournalEntry")
}

model Tenant {
  id              String    @id @default(cuid())
  businessName    String    @map("business_name")
  businessRTN     String    @unique @map("business_rtn")
  businessEmail   String    @unique @map("business_email")
  businessAddress String    @map("business_address")
  country         String    @default("HN")
  phoneNumber      String?   @map("phone_number")
  logoUrl         String?   @map("logo_url")
  timezone        String    @default("America/Tegucigalpa")
  currency        String    @default("HNL")
  subscriptionPlan String    @default("BASIC") @map("subscription_plan")
  maxUsers        Int       @default(5) @map("max_users")
  maxStorage      Int       @default(100) @map("max_storage")
  maxTransactions Int       @default(10000) @map("max_transactions")
  monthlyCost     Int       @default(1000) @map("monthly_cost")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  files           File[]
  templates        FileTemplate[]

  @@map("Tenant")
}

model File {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  originalName  String   @map("original_name")
  fileName      String   @map("file_name")
  filePath      String   @map("file_path")
  fileSize      Int      @map("file_size")
  mimeType      String   @map("mime_type")
  fileType      String   @map("file_type") // 'excel', 'pdf', 'image', etc.
  category      String   // 'accounting', 'document', 'template', etc.
  description   String?
  tags          String[] // Array de etiquetas
  uploadedBy    String   @map("uploaded_by")
  status        String   @default("active") // 'active', 'deleted', 'archived'
  metadata      Json?    // Información adicional específica por tipo de archivo
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processing    FileProcessing[]
  template      FileTemplate?
  activities    FileActivity[]

  @@index([tenantId], map: "idx_file_tenant")
  @@index([uploadedBy], map: "idx_file_uploaded_by")
  @@index([fileType], map: "idx_file_type")
  @@index([category], map: "idx_file_category")
  @@index([status], map: "idx_file_status")
  @@index([createdAt], map: "idx_file_created_at")
  @@map("File")
}

model FileProcessing {
  id             String   @id @default(cuid())
  fileId         String   @map("file_id")
  processingType String   @map("processing_type") // 'excel_import', 'data_extraction', 'validation'
  status         String   // 'pending', 'processing', 'completed', 'failed'
  progress       Int      @default(0) // Porcentaje de progreso 0-100
  totalRows      Int?     @map("total_rows")
  processedRows  Int?     @map("processed_rows")
  errorCount     Int      @default(0) @map("error_count")
  errors         String[] // Array de mensajes de error
  warnings       String[] // Array de advertencias
  results        Json?    // Resultados del procesamiento
  startedAt      DateTime @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  file           File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId], map: "idx_processing_file_id")
  @@index([status], map: "idx_processing_status")
  @@index([startedAt], map: "idx_processing_started_at")
  @@map("FileProcessing")
}

model FileTemplate {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  description  String?
  templateType String   @map("template_type") // 'excel_accounting', 'excel_invoices', etc.
  fileId       String   @unique @map("file_id") // Referencia al archivo del template
  schema       Json     // Estructura esperada del archivo
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file         File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "idx_template_tenant")
  @@index([templateType], map: "idx_template_type")
  @@index([isActive], map: "idx_template_is_active")
  @@map("FileTemplate")
}

model FileActivity {
  id        String   @id @default(cuid())
  fileId    String   @map("file_id")
  userId     String   @map("user_id")
  action     String   // 'uploaded', 'downloaded', 'viewed', 'deleted', 'processed'
  details    Json?    // Detalles específicos de la acción
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  file       File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId], map: "idx_activity_file_id")
  @@index([userId], map: "idx_activity_user_id")
  @@index([action], map: "idx_activity_action")
  @@index([createdAt], map: "idx_activity_created_at")
  @@map("FileActivity")
}
