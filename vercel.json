{
  "crons": [
    {
      "path": "/api/admin/billing/auto-generate-invoices",
      "schedule": "0 0 1 * *"
    }
  ],
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "env": {
    "DATABASE_URL": "@prod_db_url",
    "DIRECT_URL": "@prod_db_direct_url"
  },
  "functions": {
    "api/admin/migrations/*": {
      "runtime": "nodejs18.x",
      "maxDuration": 60
    }
  }
}
