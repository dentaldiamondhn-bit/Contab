{
  "crons": [
    {
      "path": "/api/admin/billing/auto-generate-invoices",
      "schedule": "0 0 1 * *"
    }
  ],
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "framework": "nextjs",

  "functions": {
    "api/admin/migrations/*": {
      "runtime": "nodejs18.x",
      "maxDuration": 60
    }
  }
}
